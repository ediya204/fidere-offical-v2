{
  "name": "fidere-trust-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "cf:build": "CF_STATIC_EXPORT=1 next build && npm run 404:generate",
    "cf:deploy": "npm run cf:build && wrangler pages deploy out --project-name=fideretrust --branch=main",
    "favicon:generate": "node scripts/generate-favicon.mjs",
    "404:generate": "node scripts/generate-static-404.mjs",
    "seo:validate": "node scripts/validate-seo.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/frank-ruhl-libre": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "sharp": "0.35.4",
    "typescript": "^5.0.0",
    "wrangler": "4.130.0"
  }
}
