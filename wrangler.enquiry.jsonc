{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fideretrust-enquiry",
  "main": "./workers/enquiry.js",
  "compatibility_date": "2026-09-09",
  "routes": [
    { "pattern": "www.fideretrust.com/api/enquiry", "zone_name": "fideretrust.com" }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "info@fideretrust.com",
      "allowed_sender_addresses": ["website@mail.fideretrust.com"]
    }
  ],
  "observability": { "enabled": true }
}
